{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@/*": ["typed-src/*"]
    }
  },
  "include": [
    "typed-src/**/*.ts",
    "typed-src/**/*.tsx",
    "wxt.config.ts"
  ]
}
